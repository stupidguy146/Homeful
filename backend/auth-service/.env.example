# auth-service — copy to .env and adjust:  cp .env.example .env
PORT=3003

# auth_db (local via docker: port 5435)
DB_HOST=localhost
DB_PORT=5435
DB_USER=auth
DB_PASSWORD=auth_pass
DB_NAME=auth_db

# JWT — use long random secrets in production (openssl rand -hex 32)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# base URL used to build email verify/reset links (points at the gateway)
APP_BASE_URL=http://localhost:3000

# customer-service (auth provisions profile + resolves username at register/login)
CUSTOMER_SERVICE_URL=http://localhost:3004
