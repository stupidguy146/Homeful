# api-gateway — copy to .env and adjust:  cp .env.example .env
PORT=3000

# downstream services (local)
CATALOG_SERVICE_URL=http://localhost:3001
ANALYTICS_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3003
CUSTOMER_SERVICE_URL=http://localhost:3004

# must match auth-service JWT_SECRET so the gateway can verify access tokens
JWT_SECRET=change_me_access_secret
